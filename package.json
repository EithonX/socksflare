{
  "name": "socksflare",
  "version": "0.3.0",
  "description": "SOCKS5 proxy client for Cloudflare Workers with TLS via Rustls WASM",
  "type": "module",
  "main": "src/index.js",
  "types": "./index.d.ts",
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "build:wasm": "cd rust-tls-wasm && wasm-pack build --target web",
    "check:wasm-api": "node scripts/check-wasm-api.mjs",
    "test": "node --test tests/protocol.test.mjs tests/integration.test.mjs tests/types-smoke.test.mjs",
    "test:unit": "node --test tests/protocol.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:package": "node --test tests/package-smoke.test.mjs",
    "pack:dry": "npm pack --dry-run",
    "release:check": "npm run check && npm run check:wasm-api && npm run test:unit && npm run test:integration && npm test && npm run test:package && npm run pack:dry",
    "prepublishOnly": "npm run check && npm run check:wasm-api && npm test && npm run test:package && npm run pack:dry"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "rust-tls-wasm/pkg/",
    "rust-tls-wasm/src/",
    "rust-tls-wasm/Cargo.toml",
    "rust-tls-wasm/Cargo.lock",
    "example/",
    "LICENSE",
    "README.md",
    "index.d.ts"
  ],
  "author": {
    "name": "EithonX",
    "url": "https://github.com/EithonX"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EithonX/socksflare.git"
  },
  "homepage": "https://github.com/EithonX/socksflare#readme",
  "bugs": {
    "url": "https://github.com/EithonX/socksflare/issues"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "socks5",
    "proxy",
    "tls",
    "wasm",
    "rustls",
    "socksflare"
  ],
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18.0.0"
  }
}
